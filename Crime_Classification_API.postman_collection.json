		{
			"name": "03. Authentication",
			"item": [
				{
					"name": "1. Admin/Officer Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var res = pm.response.json();",
									"    if (res.data && res.data.accessToken) {",
									"        pm.collectionVariables.set('token', res.data.accessToken);",
									"        console.log('Saved accessToken to variable');",
									"    }",
									"    if (res.data && res.data.refreshToken) {",
									"        pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
									"        console.log('Saved refreshToken to variable');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@crimeportal.gov\",\n  \"password\": \"Admin@12345\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Authenticates officer/admin. Auto-saves access token and refresh token into collection variables."
					},
					"response": []
				},
				{
					"name": "2. Refresh Access Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var res = pm.response.json();",
									"    if (res.data && res.data.accessToken) {",
									"        pm.collectionVariables.set('token', res.data.accessToken);",
									"    }",
									"    if (res.data && res.data.refreshToken) {",
									"        pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/refresh-token",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"refresh-token"
							]
						},
						"description": "Rotates refresh token and issues fresh access token."
					},
					"response": []
				},
				{
					"name": "3. Logout Session",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/logout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"logout"
							]
						},
						"description": "Revokes the active refresh token in the database."
					},
					"response": []
				}
			]
		},
		{
			"name": "04. Admin Triage & Operations",
			"item": [
				{
					"name": "1. Get All Reports (Triage List)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var res = pm.response.json();",
									"    if (res.data && res.data.reports && res.data.reports.length > 0) {",
									"        pm.collectionVariables.set('reportId', res.data.reports[0].id.toString());",
									"        console.log('Saved first reportId:', res.data.reports[0].id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
