						"body": {
							"mode": "raw",
							"raw": "{\n  \"citizen_name\": \"Sara Fatima\",\n  \"contact_number\": \"+923219876543\",\n  \"incident_location\": \"Online / Cyber\",\n  \"incident_date\": \"2026-10-20T14:15:00Z\",\n  \"description\": \"I received a fraudulent SMS spoofing my bank helpline asking to verify KYC. Upon entering credentials on their phishing portal, Rs. 150,000 was unauthorizedly transferred via Raast.\"\n}"
