		{
			"name": "02. Public Citizen Reports",
			"item": [
				{
					"name": "1. Submit Physical Crime Report",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var res = pm.response.json();",
									"    if (res.data && res.data.tracking_id) {",
									"        pm.collectionVariables.set('trackingId', res.data.tracking_id);",
									"        console.log('Saved trackingId:', res.data.tracking_id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"citizen_name\": \"Ahmed Bilal\",\n  \"contact_number\": \"+923001234567\",\n  \"incident_location\": \"Gulshan-e-Iqbal Block 13D, Karachi\",\n  \"incident_date\": \"2026-10-20T10:00:00Z\",\n  \"description\": \"Two armed men on a red 70cc motorcycle intercepted my vehicle at gunpoint and forcefully snatched my iPhone 15, wallet containing Rs. 25,000, and original CNIC card.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/reports",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"reports"
							]
						},
						"description": "Submits a physical crime complaint. Auto-classifies via DistilBERT and extracts Robbery & Armed Snatching, severity Critical, urgent flag, and safety advisory."
					},
					"response": []
				},
